rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Create exactly two members/{Google-auth-UID} documents in the console.
    // Membership is managed by the project owner, never by the browser.
    function member() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    match /members/{uid} { allow read, write: if false; }
    match /households/home {
      allow get: if member();
      allow create: if member() && valid() && request.resource.data.revision == 1;
      allow update: if member() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete, list: if false;
      function valid() {
        let data = request.resource.data;
        return data.keys().hasOnly(['state','revision','updatedBy','updatedAt'])
          && data.revision is int
          && data.updatedBy == request.auth.uid
          && data.updatedAt == request.time
          && data.state is map
          && data.state.keys().hasOnly(['schemaVersion','complexes','regions','filters','listings','alertSettings'])
          && data.state.schemaVersion == 2
          && data.state.complexes is list && data.state.complexes.size() <= 500
          && data.state.regions is list && data.state.regions.size() <= 500
          && data.state.listings is list && data.state.listings.size() <= 5000
          && data.state.filters is map && data.state.alertSettings is map;
      }
    }
  }
}
