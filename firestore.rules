rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Same public collaboration policy, scoped to official public presale data.
    match /households/home/feeds/presales {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if request.resource.data.keys().hasOnly(['payload','revision','updatedBy','updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 200000
        && request.resource.data.updatedBy == 'public' && request.resource.data.updatedAt == request.time
        && request.resource.data.revision is int
        && ((!exists(/databases/$(database)/documents/households/home/feeds/presales) && request.resource.data.revision == 1)
          || (exists(/databases/$(database)/documents/households/home/feeds/presales) && request.resource.data.revision == resource.data.revision + 1));
    }
    // Public collaboration explicitly selected by the owner.
    // All other documents, including members, remain inaccessible.
    match /households/home {
      allow get: if true;
      allow create: if valid() && request.resource.data.revision == 1;
      allow update: if valid()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete, list: if false;
      function valid() {
        let data = request.resource.data;
        return data.keys().hasOnly(['state','revision','updatedBy','updatedAt'])
          && data.revision is int
          && data.updatedBy == 'public'
          && data.updatedAt == request.time
          && data.state is map
          && data.state.keys().hasOnly(['schemaVersion','complexes','regions','filters','listings','alertSettings'])
          && data.state.schemaVersion == 2
          && data.state.complexes is list && data.state.complexes.size() <= 500
          && data.state.regions is list && data.state.regions.size() <= 500
          && data.state.listings is list && data.state.listings.size() <= 5000
          && data.state.filters is map && data.state.alertSettings is map;
      }
    }
  }
}
